# Code only: everything is ignored unless listed below, so sample folders (images, tracks,
# test_config.json, scale_calibration.json), comparisons/, .venv/ and decks never enter the repository.
/*

!/.gitignore
!/README.md
!/NEW_TEST_UBUNTU.md
!/CLAUDE.md
!/requirements.txt
!/analysis_settings.json
!/runDIC.sh
!/runDIC.mac.ini
!/runDIC.ubuntu.ini

# code folders: Python and Markdown files only
!/strain_tracking/
/strain_tracking/*
!/strain_tracking/*.py
!/strain_tracking/*.md
!/constitutive_fit/
/constitutive_fit/*
!/constitutive_fit/*.py
!/constitutive_fit/*.md
!/thickness/
/thickness/*
!/thickness/*.py
!/thickness/*.md
# MATLAB version (for Windows users): .m and Markdown files only
!/matlab/
/matlab/*
!/matlab/*.m
!/matlab/*.md
!/matlab/QUICKSTART.pdf
!/matlab/lib/
/matlab/lib/*
!/matlab/lib/*.m

__pycache__/
*.pyc
.DS_Store
